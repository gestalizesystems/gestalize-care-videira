<% content_for :title, "Dashboard" %>

<div class="flex items-center justify-between mb-1">
  <h1 class="text-2xl font-medium text-vdc-primary">Dashboard</h1>
  <div class="relative flex items-center gap-1.5 text-xs font-medium px-3 py-2 rounded-full bg-white shadow-sm whitespace-nowrap" style="color:#5D4037">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24"
         stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
    <span>Por mês</span>
    <select class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
            onchange="if(this.value) window.location='<%= admin_root_path %>?month='+this.value">
      <% @available_months.each do |m| %>
        <option value="<%= m.strftime('%Y-%m') %>" <%= "selected" if m == @month %>>
          <%= l(m, format: "%B de %Y").capitalize %>
        </option>
      <% end %>
    </select>
  </div>
</div>
<p class="text-sm mb-6 text-vdc-secondary"><%= l(@month, format: "%B de %Y").capitalize %></p>

<div class="grid grid-cols-2 gap-3 mb-6">
  <div class="card-sm cursor-pointer hover:shadow-md transition-all active:scale-[0.98]"
       onclick="<%= open_modal('credit-balances-modal') %>">
    <p class="text-xs mb-1 text-vdc-secondary">Créditos totais</p>
    <p class="text-2xl font-medium text-vdc-primary">R$ <%= money(@total_credits) %></p>
  </div>
  <div class="card-sm">
    <p class="text-xs mb-1 text-vdc-secondary">Créditos do mês</p>
    <p class="text-2xl font-medium text-vdc-success">R$ <%= money(@monthly_credits) %></p>
  </div>
  <div class="card-sm cursor-pointer hover:shadow-md transition-all active:scale-[0.98]"
       onclick="<%= open_modal('monthly-turnos-modal') %>">
    <p class="text-xs mb-1 text-vdc-secondary">Receita de turnos do mês</p>
    <p class="text-2xl font-medium text-vdc-success">R$ <%= money(@monthly_turnos) %></p>
  </div>
  <div class="card-sm cursor-pointer hover:shadow-md transition-all active:scale-[0.98]"
       onclick="<%= open_modal('monthly-extras-modal') %>">
    <p class="text-xs mb-1 text-vdc-secondary">Receita de insumos do mês</p>
    <p class="text-2xl font-medium text-vdc-success">R$ <%= money(@monthly_insumos) %></p>
  </div>
  <div class="card-sm col-span-2 cursor-pointer hover:shadow-md transition-all active:scale-[0.98]"
       onclick="<%= open_modal('monthly-summary-modal') %>">
    <p class="text-xs mb-1 text-vdc-secondary">Receita total do mês</p>
    <p class="text-2xl font-medium text-vdc-success">R$ <%= money(@monthly_revenue) %></p>
  </div>

  <%# ── Gráfico: barras empilhadas (turnos/insumos/crédito) ──────────────────── %>
  <div class="card-sm col-span-2">
    <p class="text-xs mb-2 text-vdc-secondary">Receita — últimos 6 meses</p>

    <%# Legenda %>
    <div class="flex items-center gap-4 mb-3 text-[11px]" style="color:#5D4037">
      <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#5D4037"></span>Turnos</span>
      <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#8D6E63"></span>Insumos</span>
      <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#C9B8A8"></span>Crédito</span>
    </div>

    <% max_total = [@monthly_series.map { |m| m[:total] }.max || 0, 1].max %>
    <% bar_w = 30; gap = 20; chart_h = 120; top_pad = 22; bottom_pad = 20 %>
    <% n = @monthly_series.size %>
    <% width = (n * bar_w) + ((n - 1) * gap) %>
    <% svg_h = top_pad + chart_h + bottom_pad %>
    <svg viewBox="0 0 <%= width %> <%= svg_h %>" class="w-full" style="height:11rem">
      <% @monthly_series.each_with_index do |m, i| %>
        <% x = i * (bar_w + gap) %>
        <% cx = x + bar_w / 2.0 %>
        <% total = m[:total] %>
        <% if total.positive? %>
          <% total_h = [((total.to_f / max_total) * chart_h).round, 3].max %>
          <% t_h = ((m[:turnos].to_f / total) * total_h).round %>
          <% i_h = ((m[:insumos].to_f / total) * total_h).round %>
          <% c_h = total_h - t_h - i_h %>
          <% base = top_pad + chart_h %>
          <a href="<%= admin_root_path %>?month=<%= m[:month].strftime('%Y-%m') %>" style="cursor:pointer">
            <%# turnos (base) %>
            <% if t_h.positive? %><rect x="<%= x %>" y="<%= base - t_h %>" width="<%= bar_w %>" height="<%= t_h %>" fill="#5D4037"/><% end %>
            <%# insumos %>
            <% if i_h.positive? %><rect x="<%= x %>" y="<%= base - t_h - i_h %>" width="<%= bar_w %>" height="<%= i_h %>" fill="#8D6E63"/><% end %>
            <%# crédito (topo, cantos arredondados) %>
            <% if c_h.positive? %><rect x="<%= x %>" y="<%= base - total_h %>" width="<%= bar_w %>" height="<%= c_h %>" fill="#C9B8A8" rx="3"/><% end %>
            <%# etiqueta total na ponta %>
            <text x="<%= cx %>" y="<%= base - total_h - 6 %>" text-anchor="middle" font-size="9" font-weight="500" fill="#5D4037">R$ <%= number_with_delimiter((total / 100.0).round) %></text>
          </a>
        <% end %>
        <%# rótulo do mês %>
        <text x="<%= cx %>" y="<%= svg_h - 5 %>" text-anchor="middle" font-size="10" fill="#8D6E63"><%= l(m[:month], format: "%b").capitalize %></text>
      <% end %>
    </svg>
  </div>
</div>

<%# ── Google Agenda ───────────────────────────────────────────────────────── %>
<div class="card-md">
  <div class="flex items-center justify-between gap-3">
    <div>
      <p class="font-medium text-sm text-vdc-primary">Google Agenda</p>
      <% if current_user.google_refresh_token.present? %>
        <p class="text-xs mt-0.5" style="color: #388E3C">
          Conectada — reservas confirmadas viram eventos automaticamente.
        </p>
      <% else %>
        <p class="text-xs mt-0.5" style="color: #8D6E63">
          Conecte para criar eventos das reservas confirmadas na sua agenda.
        </p>
      <% end %>
    </div>
    <% if current_user.google_refresh_token.present? %>
      <%= button_to "Desconectar", admin_google_calendar_path, method: :delete,
            class: "btn-sm-outline shrink-0",
            form: { data: { turbo_confirm: "Desconectar a Google Agenda?" } } %>
    <% else %>
      <%= link_to "Conectar", admin_connect_google_calendar_path, class: "btn-sm-primary shrink-0" %>
    <% end %>
  </div>
</div>

<%# ── Modal: Créditos totais por cliente ──────────────────────────────────── %>
<%= render layout: "shared/modal", locals: { id: "credit-balances-modal", title: "Créditos totais por cliente", closable: true } do %>
  <% if @credit_balances_by_client.empty? %>
    <p class="text-sm text-center py-6" style="color:#8D6E63">Nenhum cliente com crédito disponível.</p>
  <% else %>
    <div class="flex flex-col gap-2 max-h-96 overflow-y-auto">
      <% @credit_balances_by_client.each do |row| %>
        <div class="flex items-center justify-between rounded-2xl p-3 border" style="border-color:#E0E0E0">
          <span class="text-sm font-medium" style="color:#3E2723"><%= row[:user]&.name || "Cliente removido" %></span>
          <span class="text-sm font-medium" style="color:#5D4037">R$ <%= money(row[:amount_cents]) %></span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# ── Modal: Insumos vendidos no mês ──────────────────────────────────────── %>
<%= render layout: "shared/modal", locals: { id: "monthly-extras-modal", title: "Insumos vendidos — #{l(@month, format: '%B de %Y').capitalize}", closable: true } do %>
  <% if @monthly_extras_purchases.empty? %>
    <p class="text-sm text-center py-6" style="color:#8D6E63">Nenhum insumo vendido neste mês.</p>
  <% else %>
    <div class="flex flex-col gap-2 max-h-96 overflow-y-auto">
      <% @monthly_extras_purchases.each do |row| %>
        <div class="rounded-2xl p-3 border" style="border-color:#E0E0E0">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-medium" style="color:#3E2723">
              <%= row[:name] %><%= " (lançamento manual)" if row[:manual] %>
            </span>
            <span class="text-sm font-medium" style="color:#5D4037">R$ <%= money(row[:amount_cents]) %></span>
          </div>
          <% row[:items].each do |item| %>
            <p class="text-xs" style="color:#8D6E63"><%= item %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# ── Modal: Receita de turnos do mês ─────────────────────────────────────── %>
<%= render layout: "shared/modal", locals: { id: "monthly-turnos-modal", title: "Turnos do mês — #{l(@month, format: '%B de %Y').capitalize}", closable: true } do %>
  <% if @monthly_turnos_by_client.empty? %>
    <p class="text-sm text-center py-6" style="color:#8D6E63">Nenhuma receita de turno neste mês.</p>
  <% else %>
    <div class="flex flex-col gap-2 max-h-96 overflow-y-auto">
      <% @monthly_turnos_by_client.each do |row| %>
        <div class="rounded-2xl p-3 border" style="border-color:#E0E0E0">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-medium" style="color:#3E2723">
              <%= row[:name] %><%= " (lançamento manual)" if row[:manual] %>
            </span>
            <span class="text-sm font-medium" style="color:#5D4037">R$ <%= money(row[:turnos_cents]) %></span>
          </div>
          <% row[:turnos].each do |t| %>
            <p class="text-xs" style="color:#8D6E63"><%= t %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>

<%# ── Modal: Receita total do mês — resumo por cliente ────────────────────── %>
<%= render layout: "shared/modal", locals: { id: "monthly-summary-modal", title: "Consumo do mês — #{l(@month, format: '%B de %Y').capitalize}", closable: true } do %>
  <button type="button" onclick="document.getElementById('manual-revenue-form').classList.toggle('hidden')"
          class="btn-outline w-full mb-4 cursor-pointer">
    Adicionar receita
  </button>

  <div id="manual-revenue-form" class="hidden mb-4">
    <%= form_with url: admin_manual_revenue_entries_path, method: :post, data: { turbo: false }, class: "flex flex-col gap-3" do %>
      <%= hidden_field_tag :month, @month.strftime("%Y-%m") %>

      <div data-controller="client-autocomplete"
           data-client-autocomplete-clients-value="<%= @clients_for_autocomplete.map { |id, name| { id: id, name: name } }.to_json %>">
        <label class="label">Nome do cliente</label>
        <div class="relative">
          <div class="bg-[#fef8e1] rounded-2xl px-4 py-1">
            <input type="text" placeholder="Comece a digitar…" autocomplete="off" required
                   data-client-autocomplete-target="input"
                   data-action="input->client-autocomplete#search focus->client-autocomplete#search"
                   class="w-full bg-transparent border-none outline-none py-3 text-sm" style="color:#3E2723">
          </div>
          <input type="hidden" name="client_id" data-client-autocomplete-target="hidden">
          <div data-client-autocomplete-target="list"
               class="hidden absolute z-10 left-0 right-0 mt-1 bg-white rounded-2xl shadow-lg border max-h-48 overflow-y-auto"
               style="border-color:#E0E0E0"></div>
        </div>
      </div>

      <div>
        <label class="label">Valor</label>
        <div class="bg-[#fef8e1] rounded-2xl px-4 py-1">
          <input type="text" inputmode="numeric" name="amount" placeholder="R$ 0,00" required
                 data-controller="input-mask" data-input-mask-pattern-value="money"
                 class="w-full bg-transparent border-none outline-none py-3 text-sm" style="color:#3E2723">
        </div>
      </div>

      <div>
        <label class="label">Motivo da receita</label>
        <div class="bg-[#fef8e1] rounded-2xl px-4 py-1">
          <select name="category" required
                  class="w-full bg-transparent border-none outline-none py-3 text-sm cursor-pointer" style="color:#3E2723">
            <option value="">Selecione…</option>
            <option value="turno">Turno</option>
            <option value="insumo">Insumos</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn-primary w-full cursor-pointer">Salvar</button>
    <% end %>
  </div>

  <% if @monthly_summary_by_client.empty? %>
    <p class="text-sm text-center py-6" style="color:#8D6E63">Nenhuma receita registrada neste mês.</p>
  <% else %>
    <div class="flex flex-col gap-2 max-h-96 overflow-y-auto">
      <% @monthly_summary_by_client.each do |row| %>
        <div class="rounded-2xl p-3 border" style="border-color:#E0E0E0">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-medium" style="color:#3E2723"><%= row[:name] || "Cliente removido" %></span>
            <span class="text-sm font-medium" style="color:#5D4037">R$ <%= money(row[:total_cents]) %></span>
          </div>
          <% if row[:turnos].present? %>
            <p class="text-xs" style="color:#8D6E63">Turnos: <%= row[:turnos].join(", ") %></p>
          <% end %>
          <% if row[:insumos].present? %>
            <p class="text-xs" style="color:#8D6E63">Insumos: <%= row[:insumos].join(", ") %></p>
          <% end %>
          <% if row[:credits_cents].positive? %>
            <p class="text-xs" style="color:#8D6E63">Crédito comprado: R$ <%= money(row[:credits_cents]) %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>